		"test:nos-radio-mask": "node scripts/test-nos-radio-mask.mjs",
		"test:nos-roles": "node scripts/test-nos-roles.mjs",
		"test:nos-berserker": "node scripts/test-nos-berserker.mjs",
		"test:nos-citrus": "node scripts/test-nos-citrus.mjs",
		"test:nos-effect-settings": "node scripts/test-nos-effect-settings.mjs",
		"test:nos-source-filter": "node scripts/test-nos-source-filter.mjs",
		"test:nos-berserker-audio": "node scripts/test-nos-berserker-audio.mjs",
