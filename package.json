		"test:snr-cosmetics": "node scripts/test-snr-local-cosmetics.mjs",
		"test:lite-avatar": "node scripts/test-lite-no-cosmetics.mjs",
		"debug:password:add": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/set-debug-password.ps1 -Add",
		"test:nos-cosmetics": "node scripts/test-nos-cosmetics.mjs",
		"test:debug-auth": "node scripts/test-debug-auth.mjs",
		"test:remote-debug-auth": "node scripts/test-remote-debug-auth.mjs",
		"test:player-ban-transport": "node scripts/test-player-bans-public-ip.mjs",
		"test:player-ban-integration": "node scripts/test-player-ban-integration.mjs",
		"test:player-ban-ui": "node scripts/test-player-ban-ui.mjs",
		"rebuild:native": "electron-builder install-app-deps",
		"lint": "eslint src",
		"format": "prettier --write src",
		"format:check": "prettier --check src",
		"predev": "install-electron && node scripts/prepare-hero-speech.mjs",
		"dev": "electron-vite dev",
		"typecheck": "tsc --noEmit",
		"test:upstream": "node scripts/test-upstream-fixes.mjs",
		"verify:esm": "node scripts/verify-esm.mjs",
		"verify:native": "node scripts/verify-native-deps.mjs source",
		"build": "electron-vite build",
		"dist": "node scripts/prepare-hero-speech.mjs && node scripts/verify-native-deps.mjs source && powershell -File scripts/build-snr-reader.ps1 && powershell -File scripts/build-nos-reader.ps1 && electron-vite build && electron-builder --win --x64 --publish never && node scripts/verify-native-deps.mjs dist",
		"dist:32": "node scripts/prepare-hero-speech.mjs && powershell -File scripts/build-snr-reader.ps1 && powershell -File scripts/build-nos-reader.ps1 && electron-vite build && electron-builder --win --ia32",
		"dist:64": "node scripts/prepare-hero-speech.mjs && npm run dist",
		"dist:linux": "node scripts/prepare-hero-speech.mjs && electron-vite build && electron-builder --linux --x64",
		"publish": "node scripts/prepare-hero-speech.mjs && npm run dist && electron-builder --win --x64 --publish always",
		"publish:linux": "node scripts/prepare-hero-speech.mjs && electron-vite build && electron-builder --x64 --linux --publish always",
		"compile": "electron-vite build",
		"dist:lite": "node scripts/prepare-hero-speech.mjs && node scripts/verify-native-deps.mjs source && powershell -File scripts/build-snr-reader.ps1 && powershell -File scripts/build-nos-reader.ps1 && electron-vite build && electron-builder --win --x64 --config electron-builder-lite.yml --publish never && node scripts/verify-native-deps.mjs dist-lite",
		"publish:lite": "node scripts/prepare-hero-speech.mjs && npm run dist:lite && electron-builder --win --x64 --config electron-builder-lite.yml --publish always",
		"prepare:hero-speech": "node scripts/prepare-hero-speech.mjs",
		"prebuild": "node scripts/prepare-hero-speech.mjs"
	},
